classDiagram
    class Owner {
        +String name
        +String email
        +int availableMinutesPerDay
        +List~Pet~ pets
        +saveInfo() void
        +addPet(pet Pet) void
        +getAllTasks() List~Task~
    }

    class Pet {
        +String name
        +String species
        +int age
        +String notes
        +List~Task~ tasks
        +addTask(task Task) void
        +removeTask(task Task) void
    }

    class Task {
        +String title
        +TaskType type
        +int durationMinutes
        +Priority priority
        +Time preferredTime
        +bool isCompleted
        +markComplete() void
    }

    class TimeSlot {
        +Time start
        +Time end
        +durationMinutes() int
        +overlaps(other TimeSlot) bool
    }

    class Scheduler {
        +Owner owner
        +List~TimeSlot~ availability
        +prioritizeTasks(tasks List~Task~) List~Task~
        +scheduleTasks() DailyPlan
        +explainChoices(plan DailyPlan) String
    }

    class DailyPlan {
        +Date date
        +List~ScheduledItem~ items
        +List~Task~ unscheduled
        +addItem(task Task, slot TimeSlot, reason String) void
        +totalMinutes() int
    }

    class ScheduledItem {
        +Task task
        +Pet pet
        +TimeSlot slot
        +String reason
    }

    class TaskType {
        <<enumeration>>
        WALK
        FEEDING
        MEDS
        ENRICHMENT
        GROOMING
    }

    class Priority {
        <<enumeration>>
        HIGH
        MEDIUM
        LOW
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" *-- "*" Task : has
    Task --> TaskType
    Task --> Priority
    Task --> TimeSlot : preferred time
    Scheduler --> Owner : plans for
    Scheduler --> TimeSlot : uses availability
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" *-- "*" ScheduledItem : contains
    ScheduledItem --> Task
    ScheduledItem --> Pet
    ScheduledItem --> TimeSlot
